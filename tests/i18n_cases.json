    {"lang": "pt-BR", "key": "stats.span", "values": {"n": 30}, "out": "Últimos 30 dias"},
    {"lang": "pt-BR", "key": "stats.focus.sessions", "values": {"n": 1}, "out": "1 sessão"},
    {"lang": "pt-BR", "key": "stats.focus.sessions", "values": {"n": 2}, "out": "2 sessões"},
    {"lang": "en", "key": "stats.focus.tasks", "values": {"n": 1}, "out": "1 task worked on"},
    {"lang": "pt-BR", "key": "stats.focus.tasks", "values": {"n": 0}, "out": "0 tarefa trabalhada"},
    {"lang": "pt-BR", "key": "stats.focus.tasks", "values": {"n": 4}, "out": "4 tarefas trabalhadas"},
    {"lang": "pt-BR", "key": "stats.focus.streak", "values": {"current": "3 dias", "best": "1 dia"}, "out": "Sequência: 3 dias seguidos · recorde de 1 dia"},
    {"lang": "en", "key": "stats.blocks.count", "values": {"n": 1}, "out": "1 block"},
    {"lang": "pt-BR", "key": "stats.blocks.count", "values": {"n": 12}, "out": "12 bloqueios"},
    {"lang": "pt-BR", "key": "stats.apps.show_all_sites", "values": {"n": 9}, "out": "Mostrar todos os 9 sites"},
    {"lang": "pt-BR", "key": "stats.apps.row", "values": {"today": "5 min", "week": "1h 15min", "share": "40%"}, "out": "5 min hoje · 1h 15min nesta semana · 40% no foco"},

    {"lang": "en", "key": "main.timer.plan", "values": {"n": 1, "work": 25, "rest": 5}, "out": "1 pomodoro of 25 min, no break"},
    {"lang": "en", "key": "main.timer.plan", "values": {"n": 4, "work": 25, "rest": 5}, "out": "4 pomodoros of 25 min, 5 min breaks"},
    {"lang": "pt-BR", "key": "main.timer.plan", "values": {"n": 1, "work": 25, "rest": 5}, "out": "1 pomodoro de 25 min, sem intervalo"},
    {"lang": "pt-BR", "key": "main.timer.plan", "values": {"n": 4, "work": 25, "rest": 5}, "out": "4 pomodoros de 25 min, intervalos de 5 min"},
    {"lang": "en", "key": "main.tasks.subtasks", "values": {"n": 1}, "out": "1 subtask"},
    {"lang": "en", "key": "main.tasks.subtasks", "values": {"n": 3}, "out": "3 subtasks"},
    {"lang": "pt-BR", "key": "main.tasks.subtasks", "values": {"n": 1}, "out": "1 subtarefa"},
    {"lang": "pt-BR", "key": "main.tasks.subtasks", "values": {"n": 2}, "out": "2 subtarefas"},
    {"lang": "en", "key": "main.filters.matches", "values": {"n": 1}, "out": "1 task matches"},
    {"lang": "en", "key": "main.filters.matches", "values": {"n": 0}, "out": "0 tasks match"},
    {"lang": "pt-BR", "key": "main.filters.matches", "values": {"n": 0}, "out": "0 tarefa encontrada"},
    {"lang": "pt-BR", "key": "main.filters.matches", "values": {"n": 7}, "out": "7 tarefas encontradas"},
    {"lang": "en", "key": "main.tasks.plan", "values": {"n": 1, "work": 45}, "out": "45 min"},
    {"lang": "en", "key": "main.tasks.plan", "values": {"n": 3, "work": 40}, "out": "3 × 40 min"},
    {"lang": "pt-BR", "key": "main.guard.on", "values": {"n": 1}, "out": "Proteção de foco ligada · 1 bloqueio ativo"},
    {"lang": "pt-BR", "key": "main.guard.on", "values": {"n": 3}, "out": "Proteção de foco ligada · 3 bloqueios ativos"},
    {"lang": "en", "key": "main.start.go_planned_bar", "values": {"n": 1, "work": 50}, "out": "Go. 1 pomodoro of 50 min, from the task's duration (on the bar)."},
    {"lang": "pt-BR", "key": "main.start.go_planned", "values": {"n": 2, "work": 30}, "out": "Vamos lá. 2 pomodoros de 30 min, pela duração da tarefa."},
    {"lang": "pt-BR", "key": "common.phase.break", "out": "Intervalo"},
    {"lang": "pt-BR", "key": "mini.round", "values": {"round": 2, "rounds": 4}, "out": "Pomodoro 2 de 4"},
    {"lang": "en", "key": "notify.finished.text", "values": {"n": 1, "task": "Report"}, "out": "Session complete: 1 pomodoro on Report."},
    {"lang": "en", "key": "notify.finished.text", "values": {"n": 3, "task": "Report"}, "out": "Session complete: 3 pomodoros on Report."},
    {"lang": "pt-BR", "key": "notify.finished.text", "values": {"n": 0, "task": "Relatório"}, "out": "Sessão concluída: 0 pomodoro em Relatório."},
