{
  "_": "What t() gives for a key, a language and values: the same cases for buzyist/i18n.py (tests/test_i18n.py) and ui/i18n.js (tests/js/i18n.test.mjs). `cases` run against the small `catalogs` below (to reach the fallbacks the shipped catalogs can't have), `shipped` against ui/i18n/*.json.",
  "catalogs": {
    "en": {
      "_": "a note, never a key",
      "area": {
        "plain": "Hello",
        "only_en": "Only in English",
        "named": "{task} for {n} min",
        "count": {"one": "{n} pomodoro", "other": "{n} pomodoros"},
        "both": {"one": "{n} task in {area}", "other": "{n} tasks in {area}"},
        "deep": {"er": {"key": "Three levels"}}
      }
    },
    "pt-BR": {
      "area": {
        "plain": "Olá",
        "named": "{task} por {n} min",
        "count": {"one": "{n} pomodoro", "other": "{n} pomodoros"},
        "both": {"other": "{n} tarefas em {area}"},
        "deep": {"er": {"key": "Três níveis"}}
      }
    }
  },
  "cases": [
    {"lang": "en", "key": "area.plain", "out": "Hello"},
    {"lang": "pt-BR", "key": "area.plain", "out": "Olá"},
    {"lang": "pt-BR", "key": "area.deep.er.key", "out": "Três níveis"},
    {"lang": "pt-BR", "key": "area.only_en", "out": "Only in English"},
    {"lang": "pt-BR", "key": "area.nowhere", "out": "area.nowhere"},
    {"lang": "en", "key": "_", "out": "_"},
    {"lang": "fr", "key": "area.plain", "out": "Hello"},
    {"lang": "en", "key": "area.named", "values": {"task": "Report", "n": 25}, "out": "Report for 25 min"},
    {"lang": "pt-BR", "key": "area.named", "values": {"task": "Relatório", "n": 25}, "out": "Relatório por 25 min"},
    {"lang": "en", "key": "area.named", "values": {"n": 5}, "out": "{task} for 5 min"},
    {"lang": "en", "key": "area.plain", "values": {"extra": 1}, "out": "Hello"},
    {"lang": "en", "key": "area.count", "values": {"n": 1}, "out": "1 pomodoro"},
    {"lang": "en", "key": "area.count", "values": {"n": 0}, "out": "0 pomodoros"},
    {"lang": "en", "key": "area.count", "values": {"n": 2}, "out": "2 pomodoros"},
    {"lang": "en", "key": "area.count", "values": {"n": 1.5}, "out": "1.5 pomodoros"},
    {"lang": "en", "key": "area.count", "out": "{n} pomodoros"},
    {"lang": "pt-BR", "key": "area.count", "values": {"n": 0}, "out": "0 pomodoro"},
    {"lang": "pt-BR", "key": "area.count", "values": {"n": 1}, "out": "1 pomodoro"},
    {"lang": "pt-BR", "key": "area.count", "values": {"n": 1.5}, "out": "1.5 pomodoro"},
    {"lang": "pt-BR", "key": "area.count", "values": {"n": 2}, "out": "2 pomodoros"},
    {"lang": "pt-BR", "key": "area.count", "values": {"n": 1000000}, "out": "1000000 pomodoros"},
    {"lang": "en", "key": "area.both", "values": {"n": 1, "area": "Inbox"}, "out": "1 task in Inbox"},
    {"lang": "pt-BR", "key": "area.both", "values": {"n": 1, "area": "Entrada"}, "out": "1 tarefas em Entrada"},
    {"lang": "pt-BR", "key": "area.both", "values": {"n": 3, "area": "Entrada"}, "out": "3 tarefas em Entrada"}
  ],
  "shipped": [
    {"lang": "en", "key": "language.name", "out": "English"},
    {"lang": "pt-BR", "key": "language.name", "out": "Português (Brasil)"},
    {"lang": "en", "key": "settings.apps.activity.summary", "values": {"n": 1, "name": "Email", "apps": "WhatsApp"}, "out": "During Email: WhatsApp is kept away."},
    {"lang": "en", "key": "settings.apps.activity.summary", "values": {"n": 2, "name": "Email", "apps": "WhatsApp, Slack"}, "out": "During Email: WhatsApp, Slack are kept away."},
    {"lang": "pt-BR", "key": "settings.apps.activity.summary", "values": {"n": 1, "name": "E-mail", "apps": "WhatsApp"}, "out": "Durante E-mail: WhatsApp fica longe."},
    {"lang": "pt-BR", "key": "settings.apps.activity.summary", "values": {"n": 2, "name": "E-mail", "apps": "WhatsApp, Slack"}, "out": "Durante E-mail: WhatsApp, Slack ficam longe."},
    {"lang": "en", "key": "settings.sites.activity.summary.block", "values": {"n": 1, "name": "Email"}, "out": "During Email: 1 website blocked."},
    {"lang": "en", "key": "settings.sites.activity.summary.block_except", "values": {"n": 3, "m": 1, "name": "Email"}, "out": "During Email: 3 websites blocked, with 1 let through inside them."},
    {"lang": "pt-BR", "key": "settings.sites.activity.summary.allow", "values": {"n": 1, "name": "E-mail"}, "out": "Durante E-mail: só 1 site aberto."},
    {"lang": "pt-BR", "key": "settings.sites.activity.summary.allow_except", "values": {"n": 2, "m": 1, "name": "E-mail"}, "out": "Durante E-mail: só 2 sites abertos; bloqueados dentro deles: 1."},
    {"lang": "en", "key": "settings.limits.budget.hour", "values": {"n": 1, "minutes": 5}, "out": "5 min per hour"},
    {"lang": "en", "key": "settings.limits.budget.day", "values": {"n": 2, "minutes": 30}, "out": "30 min per 2 days"},
    {"lang": "pt-BR", "key": "settings.limits.budget.hour", "values": {"n": 1, "minutes": 5}, "out": "5 min por hora"},
    {"lang": "pt-BR", "key": "settings.limits.budget.week", "values": {"n": 2, "minutes": 90}, "out": "90 min a cada 2 semanas"},
    {"lang": "pt-BR", "key": "settings.sync.ago.days", "values": {"n": 3}, "out": "há 3 dias"},
    {"lang": "pt-BR", "key": "settings.todoist.plan_example", "values": {"list": "45 min → 45 min · 1h 30min → 3 × 30"}, "out": "Por exemplo: 45 min → 45 min · 1h 30min → 3 × 30"},
    {"lang": "en", "key": "summary.result", "values": {"n": 1, "duration": "25 min"}, "out": "1 pomodoro · 25 min of focus"},
    {"lang": "en", "key": "summary.result", "values": {"n": 3, "duration": "1h 15m"}, "out": "3 pomodoros · 1h 15m of focus"},
    {"lang": "pt-BR", "key": "summary.result", "values": {"n": 1, "duration": "25 min"}, "out": "1 pomodoro · 25 min de foco"},
    {"lang": "pt-BR", "key": "summary.result", "values": {"n": 3, "duration": "1h 15min"}, "out": "3 pomodoros · 1h 15min de foco"},
    {"lang": "pt-BR", "key": "common.duration.h_m", "values": {"h": 1, "m": 15}, "out": "1h 15min"},
    {"lang": "pt-BR", "key": "main.today.completed", "values": {"n": 2}, "out": "2 concluídas"},
    {"lang": "pt-BR", "key": "summary.parent_confirm", "values": {"parent": "Mudança"}, "out": "Essa era a última subtarefa de “Mudança”. Concluir essa também?"},
    {"lang": "en", "key": "summary.title_stopped", "out": "Session stopped"},
    {"lang": "pt-BR", "key": "summary.title_stopped", "out": "Sessão interrompida"}
  ]
}
